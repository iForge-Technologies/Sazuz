{
  "name": "sazuz",
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "sazuz": "tsx scripts/cli.ts",
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/tasks.ts build",
    "docs:build": "tsx scripts/docs.ts",
    "release:images": "tsx scripts/release.ts",
    "lint": "tsx scripts/lint.ts && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsx scripts/tasks.ts typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --config vitest.coverage.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:frontend": "playwright test --config=tests/frontend/playwright.config.ts",
    "test:dev": "tsx scripts/smoke-dev.ts",
    "db:generate": "pnpm --filter @sazuz/db generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "infra:bootstrap": "tsx scripts/bootstrap.ts"
  },
  "devDependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.64.1",
    "@sazuz/browser": "workspace:*",
    "@sazuz/config": "workspace:*",
    "@sazuz/core": "workspace:*",
    "@sazuz/db": "workspace:*",
    "@sazuz/ops": "workspace:*",
    "@sazuz/sandbox": "workspace:*",
    "@sazuz/vault": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-orm": "0.45.4",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "markdown-it": "15.0.3",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "ulid": "3.0.2",
    "vitest": "5.1.0",
    "ws": "8.22.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
